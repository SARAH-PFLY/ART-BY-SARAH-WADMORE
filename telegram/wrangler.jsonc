{
  "name": "sarah-artwork-upload",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "REPO": "SARAH-PFLY/ART-BY-SARAH-WADMORE",
    "SARAH_USER_ID": "1019741898"
  },
  "kv_namespaces": [
    {
      "binding": "ART_DRAFTS",
      "id": "c22ed3c9a86743fa8877f18de469019e"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BULK_SESSIONS",
        "class_name": "BulkUploads"
      }
    ]
  },
  "migrations": [
    {
      "tag": "bulk-v1",
      "new_sqlite_classes": [
        "BulkUploads"
      ]
    }
  ]
}
